{
  "name": "gozne",
  "version": "0.1.0-dev.16",
  "description": "Self-hosted wallet authentication and signed action approvals",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24.20.0 <25"
  },
  "bin": {
    "gozne": "dist/cli/gozne.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/cli/gozne.js serve",
    "cli": "node dist/cli/gozne.js",
    "test": "node --test dist/test/*.test.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run build && npm test",
    "deployment:check": "node --use-system-ca dist/cli/check-deployment.js"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/rate-limit": "11.2.0",
    "@noble/curves": "2.4.0",
    "@scure/base": "2.0.0",
    "@solana/wallet-standard-util": "1.1.3",
    "ethers": "6.17.0",
    "fastify": "5.12.3",
    "siwe": "3.0.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "eslint": "10.10.0",
    "globals": "17.12.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0"
  }
}
